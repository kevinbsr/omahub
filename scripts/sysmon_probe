#!/bin/bash

# omarchy:summary=Emit one JSON snapshot of CPU, RAM, GPU and disk usage
# omarchy:hidden=true
#
# Feeds kevinbsr.omahub's System tab. Network is deliberately left out: Omarchy's own
# Network panel already covers it.
#
# dGPU RULE: nvidia-smi only runs when runtime_status == active.
#
# The proprietary driver exposes neither hwmon nor gpu_busy_percent in sysfs, so
# NVIDIA usage, temperature and VRAM only come from NVML (nvidia-smi). But every
# query wakes the chip to P0/1702MHz -- the old waybar sys-summary.sh did this
# every 1s, and the monitor itself was what kept the GPU awake.
#
# With the chip already on, querying doesn't wake it further, so it's allowed. In
# "suspended" the GPU has no power: there's no usage or temperature to read, and
# querying would be exactly what wakes it. That leaves only the runtime PM
# counters (runtime_active_time / runtime_suspended_time), which don't disturb it.

set -uo pipefail

state_dir="${XDG_RUNTIME_DIR:-/tmp}/omarchy-sysmon"
mkdir -p "$state_dir"

# ---------------------------------------------------------------- CPU
read_cpu_sample() {
  awk '$1 == "cpu" { total = $2+$3+$4+$5+$6+$7+$8+$9; idle = $5+$6; print total, idle; exit }' /proc/stat
}

cpu_percent=0
cpu_state="$state_dir/cpu"
now_sample=$(read_cpu_sample)
if [[ -r $cpu_state ]]; then
  prev_sample=$(<"$cpu_state")
  cpu_percent=$(awk -v p="$prev_sample" -v n="$now_sample" 'BEGIN {
    split(p, a, " "); split(n, b, " ")
    dt = b[1] - a[1]; di = b[2] - a[2]
    if (dt > 0) printf "%d", 100 * (dt - di) / dt; else print 0
  }')
else
  # First run: there's no previous window, so take a short sample instead
  # of reporting 0.
  sleep 0.15
  later=$(read_cpu_sample)
  cpu_percent=$(awk -v p="$now_sample" -v n="$later" 'BEGIN {
    split(p, a, " "); split(n, b, " ")
    dt = b[1] - a[1]; di = b[2] - a[2]
    if (dt > 0) printf "%d", 100 * (dt - di) / dt; else print 0
  }')
  now_sample=$later
fi
printf '%s\n' "$now_sample" >"$cpu_state"

cpu_temp=0
for hwmon in /sys/class/hwmon/hwmon*; do
  case "$(cat "$hwmon/name" 2>/dev/null)" in
    k10temp | coretemp)
      raw=$(cat "$hwmon/temp1_input" 2>/dev/null)
      [[ -n ${raw:-} ]] && cpu_temp=$(awk -v v="$raw" 'BEGIN { printf "%.1f", v / 1000 }')
      break
      ;;
  esac
done

cpu_cores=$(nproc 2>/dev/null || echo 0)

# ---------------------------------------------------------------- RAM
read -r mem_total mem_available < <(awk '
  /^MemTotal:/ { total = $2 }
  /^MemAvailable:/ { available = $2 }
  END { print total, available }
' /proc/meminfo)
mem_used=$((mem_total - mem_available))
mem_percent=$((mem_total > 0 ? 100 * mem_used / mem_total : 0))

read -r swap_total swap_free < <(awk '
  /^SwapTotal:/ { total = $2 }
  /^SwapFree:/ { free = $2 }
  END { print total, free }
' /proc/meminfo)
swap_used=$((swap_total - swap_free))
swap_percent=$((swap_total > 0 ? 100 * swap_used / swap_total : 0))

# ---------------------------------------------------------------- iGPU (AMD)
igpu_present=false
igpu_busy=0
igpu_temp=0
igpu_watts=0
igpu_vram_used=0
igpu_vram_total=0
igpu_mhz=0

for card in /sys/class/drm/card*/device; do
  [[ -r $card/gpu_busy_percent ]] || continue
  igpu_present=true
  igpu_busy=$(cat "$card/gpu_busy_percent" 2>/dev/null || echo 0)
  used=$(cat "$card/mem_info_vram_used" 2>/dev/null || echo 0)
  total=$(cat "$card/mem_info_vram_total" 2>/dev/null || echo 0)
  igpu_vram_used=$((used / 1048576))
  igpu_vram_total=$((total / 1048576))
  for hwmon in "$card"/hwmon/hwmon*; do
    raw=$(cat "$hwmon/temp1_input" 2>/dev/null)
    [[ -n ${raw:-} ]] && igpu_temp=$(awk -v v="$raw" 'BEGIN { printf "%.1f", v / 1000 }')
    raw=$(cat "$hwmon/power1_input" 2>/dev/null)
    [[ -n ${raw:-} ]] && igpu_watts=$(awk -v v="$raw" 'BEGIN { printf "%.1f", v / 1000000 }')
    raw=$(cat "$hwmon/freq1_input" 2>/dev/null)
    [[ -n ${raw:-} ]] && igpu_mhz=$(awk -v v="$raw" 'BEGIN { printf "%d", v / 1000000 }')
    break
  done
  break
done

# ---------------------------------------------------------------- dGPU (NVIDIA)
# Runtime PM counters only. "asleep" here means true D3cold.
dgpu_present=false
dgpu_status="absent"
dgpu_active_percent=0
dgpu_power_state=""
dgpu_detailed=false
dgpu_busy=0
dgpu_vram_used=0
dgpu_vram_total=0
dgpu_temp=0
dgpu_watts=0
dgpu_mhz=0

for dev in /sys/bus/pci/devices/*; do
  vendor=$(cat "$dev/vendor" 2>/dev/null)
  class=$(cat "$dev/class" 2>/dev/null)
  [[ $vendor == "0x10de" && $class == 0x0300* ]] || continue

  dgpu_present=true
  dgpu_status=$(cat "$dev/power/runtime_status" 2>/dev/null || echo unknown)

  active_ms=$(cat "$dev/power/runtime_active_time" 2>/dev/null || echo 0)
  now_ms=$(awk '{ printf "%d", $1 * 1000 }' /proc/uptime)
  dgpu_state="$state_dir/dgpu"

  if [[ -r $dgpu_state ]]; then
    read -r prev_active prev_now <"$dgpu_state"
    dgpu_active_percent=$(awk -v pa="$prev_active" -v pn="$prev_now" -v a="$active_ms" -v n="$now_ms" 'BEGIN {
      dw = n - pn
      da = a - pa
      if (dw <= 0) { print 0; exit }
      pct = 100 * da / dw
      if (pct < 0) pct = 0
      if (pct > 100) pct = 100
      printf "%d", pct
    }')
  fi
  printf '%s %s\n' "$active_ms" "$now_ms" >"$dgpu_state"

  dgpu_power_state=$(cat "$dev/power_state" 2>/dev/null || echo "")

  # NVIDIA usage, temperature and VRAM only exist via NVML (nvidia-smi): the
  # proprietary driver exposes neither hwmon nor gpu_busy_percent in sysfs.
  #
  # The query only runs when runtime_status == active, i.e. with the chip
  # already on -- so it doesn't wake it. In "suspended" the GPU has NO power
  # and there's nothing to read: querying would be exactly what wakes it.
  if [[ $dgpu_status == "active" ]] && command -v nvidia-smi >/dev/null 2>&1; then
    # A query already in flight can take a while; don't stack another one.
    if ! pgrep -x nvidia-smi >/dev/null 2>&1; then
      smi=$(timeout -k 1 2 nvidia-smi \
        --query-gpu=utilization.gpu,memory.used,memory.total,temperature.gpu,power.draw,clocks.sm \
        --format=csv,noheader,nounits 2>/dev/null | head -n1)
      if [[ -n ${smi:-} ]]; then
        IFS=',' read -r smi_busy smi_used smi_total smi_temp smi_watts smi_mhz <<<"$smi"
        dgpu_busy=$(tr -dc '0-9' <<<"$smi_busy")
        dgpu_vram_used=$(tr -dc '0-9' <<<"$smi_used")
        dgpu_vram_total=$(tr -dc '0-9' <<<"$smi_total")
        dgpu_temp=$(tr -dc '0-9.' <<<"$smi_temp")
        dgpu_watts=$(tr -dc '0-9.' <<<"$smi_watts")
        dgpu_mhz=$(tr -dc '0-9' <<<"$smi_mhz")
        dgpu_detailed=true
      fi
    fi
  fi
  break
done

# ---------------------------------------------------------------- Disks
disks_json=$(
  for entry in "Root:/" "Home:/home"; do
    label="${entry%%:*}"
    mount="${entry#*:}"
    mountpoint -q "$mount" 2>/dev/null || [[ $mount == "/" ]] || continue
    # Percentage the way df reports it: used over used+available, rounded up.
    # Dividing by the device size instead counts chunks btrfs has allocated but
    # will not hand out, so the hub showed 90% while df and the disk alert said
    # 91% for the same filesystem (2026-09-17: 429.44 used, 476.92 size, 45.28
    # available). Two numbers for one thing is worse than either number.
    df -B1 --output=used,size,avail "$mount" 2>/dev/null | awk -v label="$label" -v mount="$mount" '
      NR == 2 {
        usable = $1 + $3
        pct = (usable > 0) ? int(100 * $1 / usable + 0.999999) : 0
        printf "{\"label\":\"%s\",\"mount\":\"%s\",\"used\":%d,\"total\":%d,\"avail\":%d,\"percent\":%d}\n", label, mount, $1, $2, $3, pct
      }'
  done | paste -sd,
)

# ---------------------------------------------------------------- Output
cat <<JSON
{
  "cpu": {"percent": ${cpu_percent:-0}, "temp": ${cpu_temp:-0}, "cores": ${cpu_cores:-0}},
  "ram": {"usedKb": $mem_used, "totalKb": $mem_total, "percent": $mem_percent},
  "swap": {"usedKb": $swap_used, "totalKb": $swap_total, "percent": $swap_percent},
  "igpu": {"present": $igpu_present, "busy": ${igpu_busy:-0}, "temp": ${igpu_temp:-0}, "watts": ${igpu_watts:-0}, "vramUsedMi": $igpu_vram_used, "vramTotalMi": $igpu_vram_total, "mhz": ${igpu_mhz:-0}},
  "dgpu": {"present": $dgpu_present, "status": "$dgpu_status", "powerState": "$dgpu_power_state", "activePercent": ${dgpu_active_percent:-0}, "detailed": $dgpu_detailed, "busy": ${dgpu_busy:-0}, "temp": ${dgpu_temp:-0}, "watts": ${dgpu_watts:-0}, "vramUsedMi": ${dgpu_vram_used:-0}, "vramTotalMi": ${dgpu_vram_total:-0}, "mhz": ${dgpu_mhz:-0}},
  "disks": [${disks_json:-}]
}
JSON
